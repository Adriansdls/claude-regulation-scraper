# LLM API Keys (at least one required)
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# Paper APIs (Semantic Scholar recommended, others optional)
SEMANTIC_SCHOLAR_API_KEY=  # Optional, but recommended for higher rate limits

# Storage
REDIS_URL=redis://localhost:6379/0

# Database (SQLite default, or use PostgreSQL)
DATABASE_URL=sqlite:///./data/research_graph.db
# DATABASE_URL=postgresql://user:pass@localhost/research_graph

# Configuration
DEFAULT_LLM=anthropic  # Options: anthropic, openai
MAX_PAPERS=10000  # Maximum papers to discover
CACHE_ENABLED=true

# Discovery Settings
RELEVANCE_THRESHOLD=0.6  # 0-1, higher = more strict
MAX_CONCURRENT_REQUESTS=10
